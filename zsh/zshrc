# ============================================================
# Powerlevel10k Instant Prompt (ファイルの最上部に配置必須)
# ============================================================
if [[ -r "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================
# キーバインド設定
# ============================================================
# Emacs キーバインドを使用
bindkey -e

# Delete キーを正しく機能させる
bindkey '\e[3~' delete-char

# ============================================================
# エイリアス設定
# ============================================================
# エディタ
alias vim=nvim
alias code='code-insiders'

# カラー表示と便利なオプション
alias ls='ls --color=always -l1'
alias tree='tree -C'

# ============================================================
# 環境変数・PATH設定
# ============================================================
# Homebrew
export PATH="/opt/homebrew/bin:${PATH}"
export PATH="/opt/homebrew/opt/unzip/bin:${PATH}"

# Nodebrew (Node.js バージョン管理)
export PATH="${HOME}/.nodebrew/current/bin:${PATH}"

# pyenv (Python バージョン管理)
export PYENV_ROOT="${HOME}/.pyenv"
export PATH="${PYENV_ROOT}/bin:${PATH}"
eval "$(pyenv init --path)"
eval "$(pyenv init -)"

# エディタ設定
export EDITOR=vim

# ============================================================
# Zsh 設定
# ============================================================
# 補完機能の有効化
autoload -U compinit && compinit

# ============================================================
# zplug (プラグイン管理)
# ============================================================
export ZPLUG_HOME="/opt/homebrew/opt/zplug"
source "${ZPLUG_HOME}/init.zsh"

# プラグインの読み込み
zplug "romkatv/powerlevel10k", as:theme, depth:1       # テーマ
zplug "zsh-users/zsh-syntax-highlighting"              # シンタックスハイライト
zplug "chrissicool/zsh-256color"                       # 256色対応

zplug load

# Powerlevel10k 設定ファイルの読み込み
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh



# fzf で SSH 接続先を選択して接続
# 参考: https://qiita.com/kamykn/items/9a831862038efa4e9f8f
fssh() {
    local sshLoginHost
    sshLoginHost=$(grep -i '^host' ~/.ssh/config | awk '{print $2}' | fzf)

    if [[ -z "${sshLoginHost}" ]]; then
        return 1
    fi

    echo "ssh established to ${sshLoginHost}."
    ssh "${sshLoginHost}"
}

# fzf で選択したホストに sshuttle でトンネル接続 (/32)
fsshuttle() {
    # .ssh/config からホスト名を抽出 (ワイルドカードを除く)
    local hosts=$(awk '/^Host / && !/\*/ {print $2}' ~/.ssh/config)

    # fzf でホスト名を選択
    local selected_host=$(echo "${hosts}" | fzf --prompt='Select Host: ')

    [[ -z "${selected_host}" ]] && return 1

    # SSH設定から実際のIPアドレス(hostname)を取得
    local ip_address=$(ssh -G "${selected_host}" | awk '/^hostname / {print $2}')

    # sshuttle でトンネルを確立
    if [[ -n "${ip_address}" ]]; then
        echo "Tunnel established to ${selected_host} (${ip_address})."
        sshuttle -r ssh-gw "${ip_address}/32"
    else
        echo "IP address could not be determined for host ${selected_host}"
    fi
}

# Git リポジトリのルートディレクトリに移動
cdroot() {
    cd "$(git rev-parse --show-toplevel)" || echo "Not a git repository."
}